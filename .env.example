# BibleWay App - Environment Variables
# Copy this file to .env.local and fill in the values.
# Expo loads .env.local automatically during development (npx expo start).
# For EAS builds, set these in eas.json under each build profile's "env" key.

# Backend API base URL (required in production, falls back to localhost in dev)
EXPO_PUBLIC_API_BASE_URL=https://your-backend-url.com/api/v1

# Google Sign-In (get from Google Cloud Console > APIs & Services > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Firebase (required for Google Auth)
# Place google-services.json (Android) in project root.
# Place GoogleService-Info.plist (iOS) in the ios/ directory.
# Get both from: Firebase Console > Project Settings > Your Apps
